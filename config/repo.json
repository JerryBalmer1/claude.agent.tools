{
  "schema": "claude.agent.repo/1",
  "repo": "JerryBalmer1/claude.agent.images",
  "branches": {
    "main": "main",
    "develop": "develop",
    "feature_prefix": "feature/"
  },
  "flow": [
    [ "feature/*", "develop" ],
    [ "develop", "main" ]
  ],
  "merge": {
    "strategy": "merge",
    "delete_branch_on_merge": true
  },
  "review": {
    "mode": "auto",
    "note": "auto while the reconciliation lands; flip to human and regenerate once main and develop agree"
  },
  "required_checks": [
    "requires-header",
    "trailer-guard",
    "branch-flow",
    "generated-match-config",
    "pester",
    "incontainer",
    "forensic-verify"
  ],
  "scripts": {
    "requires_version": "7.4"
  },
  "tooling": {
    "pester": "6.1.0",
    "invokebuild": "5.14.23"
  },
  "trailer": {
    "key": "who",
    "allowed": [ "claude", "grok", "fable", "jerry" ]
  },
  "owners": [ "@JerryBalmer1" ]
}
