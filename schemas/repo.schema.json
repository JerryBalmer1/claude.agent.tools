{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/JerryBalmer1/claude.agent.images/schemas/repo.schema.json",
  "title": "claude.agent.repo/1",
  "description": "The single source of truth for this repo's branch names, merge strategy, review mode, required checks and script version floor. Everything docs/POLICY.md and the PR template say is rendered from here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repo",
    "branches",
    "flow",
    "merge",
    "review",
    "required_checks",
    "scripts",
    "tooling",
    "trailer",
    "owners"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "claude.agent.repo/1"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
    },
    "branches": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "main", "develop", "feature_prefix" ],
      "properties": {
        "main": { "type": "string", "minLength": 1 },
        "develop": { "type": "string", "minLength": 1 },
        "feature_prefix": { "type": "string", "minLength": 1 }
      }
    },
    "flow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "strategy", "delete_branch_on_merge" ],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [ "merge" ],
          "description": "Merge commits only. Squash and rebase are never valid here: hashes are evidence."
        },
        "delete_branch_on_merge": { "type": "boolean" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "mode", "note" ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [ "auto", "human" ],
          "description": "auto = the automerge workflow merges green PRs. human = automerge stands down."
        },
        "note": { "type": "string" }
      }
    },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "scripts": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "requires_version" ],
      "properties": {
        "requires_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        }
      }
    },
    "tooling": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "pester" ],
      "properties": {
        "pester": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Exact Pester version CI installs and runs. Pinned, not floating: a test suite whose runner drifts is not a control."
        },
        "invokebuild": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Exact InvokeBuild version the incontainer CI job installs to run Invoke-Build Test.InContainer. Pinned for the same reason Pester is."
        }
      }
    },
    "trailer": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "key", "allowed" ],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z]+$" },
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]+$" }
        }
      }
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^@[A-Za-z0-9-]+$" }
    }
  }
}
